#!/bin/sh
#
# Blocks content that is a problem once it reaches other people: malformed
# frontmatter, and references that do not resolve.
#
# The split with pre-commit is deliberate. pre-commit blocks what is a problem
# once it is in history at all -- credentials, which cannot be un-leaked by a
# later commit. pre-push blocks what is a problem once someone else pulls it.
#
# Enable it in a fresh clone with:
#
#     git config core.hooksPath .githooks
#
# Fails closed. A missing script, no available Python 3, or an unresolvable
# repository root refuses the push. An exit code of 0 means every check ran and
# passed, never that a check could not run.
#
# Scope caveat, deliberately not papered over: these checks run against the
# WORKING TREE, not against the commits being pushed. If your working tree
# differs from what you are pushing, this hook checked the wrong thing. CI
# closes that gap by checking the pushed ref; this hook is an early catch, not
# the control.
#
# `git commit --no-verify`, `git push --no-verify`, an unset core.hooksPath and
# a hook without its executable bit all bypass this silently.

set -eu

if ! repo_root=$(git rev-parse --show-toplevel 2>/dev/null); then
    echo "pre-push: cannot determine the repository root. Refusing the push." >&2
    exit 1
fi

# Resolve a Python 3 interpreter. `python3` is not present on a default
# Windows install, where it is `python` or the `py` launcher, and Git Bash
# inherits that. Each candidate is probed for being genuinely Python 3 rather
# than trusted by name: a `python` can still be Python 2, and the Microsoft
# Store ships a `python.exe` stub that exists, prints an advert and exits.
#
# This stays fail-closed. If no candidate proves itself, the operation is
# refused, exactly as before -- the list of names got longer, not laxer.
PY3=""
for candidate in python3 python py; do
    command -v "$candidate" >/dev/null 2>&1 || continue
    if [ "$candidate" = "py" ]; then
        if py -3 -c 'import sys; sys.exit(0 if sys.version_info[0] == 3 else 1)' \
                >/dev/null 2>&1; then
            PY3="py -3"
            break
        fi
    elif "$candidate" -c 'import sys; sys.exit(0 if sys.version_info[0] == 3 else 1)' \
            >/dev/null 2>&1; then
        PY3="$candidate"
        break
    fi
done

if [ -z "$PY3" ]; then
    echo "pre-push: no Python 3 found (tried python3, python, py -3)." >&2
    echo "pre-push: refusing the push." >&2
    exit 1
fi

CHECKS="validate check_sources check_links check_supersession"

for name in $CHECKS; do
    if [ ! -f "$repo_root/tools/$name.py" ]; then
        echo "pre-push: $repo_root/tools/$name.py is missing. Refusing the push." >&2
        exit 1
    fi
done

failed=""
for name in $CHECKS; do
    if ! $PY3 "$repo_root/tools/$name.py"; then
        failed="$failed $name"
    fi
done

if [ -n "$failed" ]; then
    echo "" >&2
    echo "PUSH BLOCKED. Failing checks:$failed" >&2
    echo "Run any of them on its own:  $PY3 tools/<name>.py" >&2
    echo "" >&2
    exit 1
fi

exit 0
