#!/bin/sh
#
# Blocks credentials from entering the history. Scans staged content only.
#
# Enable it in a fresh clone with:
#
#     git config core.hooksPath .githooks
#
# Fails closed. If the scanner is missing, no Python 3 is available, or the
# repository root cannot be determined, the commit is refused rather than
# allowed through unchecked. An exit code of 0 from this hook means the scan
# ran and found nothing, never that the scan could not run.
#
# `git commit --no-verify` still bypasses this, as it bypasses every hook. The
# check is mirrored in CI so that a bypassed commit is caught before merge.

set -eu

if ! repo_root=$(git rev-parse --show-toplevel 2>/dev/null); then
    echo "pre-commit: cannot determine the repository root. Refusing the commit." >&2
    exit 1
fi

scanner="$repo_root/tools/check_secrets.py"

if [ ! -f "$scanner" ]; then
    echo "pre-commit: scanner not found at $scanner. Refusing the commit." >&2
    echo "pre-commit: restore it, or run with --no-verify if you know why it is gone." >&2
    exit 1
fi

# Resolve a Python 3 interpreter. `python3` is not present on a default
# Windows install, where it is `python` or the `py` launcher, and Git Bash
# inherits that. Each candidate is probed for being genuinely Python 3 rather
# than trusted by name: a `python` can still be Python 2, and the Microsoft
# Store ships a `python.exe` stub that exists, prints an advert and exits.
#
# This stays fail-closed. If no candidate proves itself, the operation is
# refused, exactly as before -- the list of names got longer, not laxer.
PY3=""
for candidate in python3 python py; do
    command -v "$candidate" >/dev/null 2>&1 || continue
    if [ "$candidate" = "py" ]; then
        if py -3 -c 'import sys; sys.exit(0 if sys.version_info[0] == 3 else 1)' \
                >/dev/null 2>&1; then
            PY3="py -3"
            break
        fi
    elif "$candidate" -c 'import sys; sys.exit(0 if sys.version_info[0] == 3 else 1)' \
            >/dev/null 2>&1; then
        PY3="$candidate"
        break
    fi
done

if [ -z "$PY3" ]; then
    echo "pre-commit: no Python 3 found (tried python3, python, py -3)." >&2
    echo "pre-commit: refusing the commit." >&2
    exit 1
fi

# Unquoted on purpose: "py -3" must split into a command and its argument.
exec $PY3 "$scanner" --staged
