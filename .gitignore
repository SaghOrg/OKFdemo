# Generation-time tooling — not part of the knowledge base.
# The schema validator used to live in _build/ and was ignored by this rule.
# It is now tracked at /tools/validate.py; do not put checks under _build/.
_build/
_snapshots/
.venv-synth/

# Python
__pycache__/
*.py[cod]

# OS
.DS_Store
Thumbs.db

# Never commit media — recordings are linked, not stored
*.mp4
*.m4a
*.wav
*.mov
*.avi

# Claude Code local session state
.claude/
